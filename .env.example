# ADMed All (일반기관) 운영 설정 예시. 복사해 `.env` 로 쓰고(.env 는 git 에 올리지 않는다), CI 에서는 secrets.ENV_FILE 에 내용을 넣는다.
# 일반기관 v2 백엔드 기준이다(/dapi/device/scenario 의 templates·waitingInfo 응답, /file/local/download/template).

# 필수 — 기기 serial 은 앱이 ?id={serial} 로 붙인다(%APPDATA%/ADMed All/device_config.ini 또는 우클릭 → 관리자 설정)
SCENARIO_API_URL=https://www.admed.co.kr/dapi/device/scenario
TEMPLATE_BASE_URL=https://www.admed.co.kr/file/local/download/template
# 공지는 SCENARIO_API_URL 의 origin 에서 /dapi/device/notice?id={serial} 로 받는다(별도 설정 없음).

# 시리얼 미설정·재생목록 없음일 때 띄우는 화면(기본 https://www.admed.co.kr)
LANDING_URL=https://www.admed.co.kr
# 참고: 기기 화면 웹 주소는 https://device.admed.co.kr (이 앱은 쓰지 않음)

# 선택 — 날씨 패널(waitingInfo=B). 키가 없으면 패널만 보이고 값은 비어 있다.
WEATHER_SERVICE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0/getUltraSrtFcst
WEATHER_SERVICE_KEY=
# WEATHER_LAT=
# WEATHER_LON=

# 선택 — 관리자 설정(기기 serial 변경) 비밀번호. 비우면 바로 바꿀 수 있다.
ADMIN_PASSWORD=

# 선택 — 자동 업데이트. 확인 간격(시간, 기본 6, 최소 1)과 운영 중 받은 업데이트를 설치할 시각(0~23시, 기본 3).
# UPDATE_CHECK_INTERVAL_HOURS=6
# UPDATE_INSTALL_HOUR=3
